# Sandbox-MCP image only needs root manifests + the two workspace packages.
# Everything else either is reproducible (dist/, _site/, packages/sandbox-fixtures/{bundles,personas,manifest.json,…}) or unrelated to runtime.

# Heavy / regenerated
node_modules/
**/node_modules/
dist/
_site/
packages/sandbox-fixtures/bundles/
packages/sandbox-fixtures/personas/
packages/sandbox-fixtures/manifest.json
packages/sandbox-fixtures/spec.json
packages/sandbox-fixtures/pools.json
packages/sandbox-fixtures-py/

# Tooling caches / reports
.vitest-cache/
.lighthouseci/
playwright-report/
test-results/
coverage/

# Frontend / docs / e2e (irrelevant to MCP runtime)
src/
tests/e2e/
.github/
.git/

# Editors / OS
.DS_Store
*.log
npm-debug.log*

# Env
.env
.env.local
