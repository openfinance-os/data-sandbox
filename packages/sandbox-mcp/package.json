{
  "name": "@openfinance-os/sandbox-mcp",
  "version": "0.0.1",
  "description": "MCP server that exposes the Open Finance Data Sandbox (synthetic UAE Open Finance v2.1 fixtures across three domains: Bank Data Sharing, Insurance Data Sharing — all 7 lines — and the ATM Locator) as tools, resources, and prompts so Claude can act as a dynamic PFM. Stdio + Streamable HTTP transports; 39 curated personas plus a custom-persona builder; anonymous by default.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "open-finance",
    "uae",
    "synthetic-data",
    "pfm",
    "commons"
  ],
  "homepage": "https://github.com/openfinance-os/data-sandbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/openfinance-os/data-sandbox.git",
    "directory": "packages/sandbox-mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./server": "./src/server.mjs"
  },
  "bin": {
    "sandbox-mcp": "./src/index.mjs"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node src/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openfinance-os/sandbox-fixtures": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
